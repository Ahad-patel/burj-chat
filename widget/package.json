{
  "name": "@burj/chat-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable AI assistant widget for burjconstructions.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings 0",
    "verify": "npm run build && node tests/isolation.browser.mjs",
    "check": "npm run typecheck && npm run test && npm run verify"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
