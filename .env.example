# ---------------------------------------------------------------------------
# Burj Constructions AI Assistant — environment template
#
# Copy to .env and fill in. NEVER commit .env (it is gitignored, and CI runs
# gitleaks to catch it if that ever changes).
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# local | staging | production. Controls log format and error verbosity.
APP_ENV=local
LOG_LEVEL=INFO


# --- LLM provider -----------------------------------------------------------
# THE swap switch. Changing this value is the only change required to move
# between providers — no code changes anywhere.
#   gemini             — Google AI Studio free tier (development default)
#   anthropic          — Claude (production option)
#   openai_compatible  — any open-weight model behind an OpenAI-compatible API
LLM_PROVIDER=gemini

# Only the key for the ACTIVE provider is required; the others may be left
# blank. These are server-side only. The widget never receives them.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=

GEMINI_MODEL=gemini-2.0-flash

# Anthropic model. Cheaper options exist and are defensible for a public widget
# — every request carries the whole ~5k-token knowledge base, so input cost
# dominates. That is a deliberate cost decision for the client to make, not one
# to bury in a default:
#   claude-opus-5        $5 / $25 per MTok   (default — highest quality)
#   claude-sonnet-5      $3 / $15 per MTok
#   claude-haiku-4-5     $1 / $5  per MTok   (cheapest; fine for grounded Q&A)
ANTHROPIC_MODEL=claude-opus-5

# Low temperature — we want faithful recall of the knowledge base, not creative
# writing.
#
# NOTE: current Claude models (Opus 5, Sonnet 5, Opus 4.8/4.7) REJECT this
# parameter with a 400. The Anthropic adapter therefore omits it for those
# models and applies it only where it is accepted. Gemini uses it directly.
# Nothing here needs changing — the adapter absorbs the difference.
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=20


# --- Knowledge base ---------------------------------------------------------
# Generated by `make kb`. Loaded once at startup into an immutable entity.
KB_PATH=knowledge-base/knowledge_base.xml


# --- API security -----------------------------------------------------------
# Comma-separated. Locked to the client's domain; no wildcards in production.
CORS_ALLOWED_ORIGINS=https://burjconstructions.com,https://www.burjconstructions.com

# Rate limits — these exist to cap LLM spend, not just to stop abuse.
RATE_LIMIT_PER_IP_PER_MINUTE=20
RATE_LIMIT_PER_SESSION_PER_HOUR=100

# Conversation retention. In-memory only; conversations are lost on restart.
# There is no database in this system by design.
CONVERSATION_TTL_MINUTES=30
MAX_MESSAGES_PER_CONVERSATION=40


# --- Voice (Phase 7 only — leave blank until then) --------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=


# --- Open-weight models (LLM_PROVIDER=openai_compatible) --------------------
# One adapter covers every service speaking the OpenAI chat-completions API,
# so switching between them is a URL change, not a code change.
#
#   Provider    Free tier   Base URL                                Example model
#   ---------------------------------------------------------------------------
#   Groq        generous    https://api.groq.com/openai/v1          llama-3.3-70b-versatile
#   OpenRouter  some free   https://openrouter.ai/api/v1            meta-llama/llama-3.3-70b-instruct:free
#   Together    credits     https://api.together.xyz/v1             meta-llama/Llama-3.3-70B-Instruct-Turbo
#   DeepInfra   credits     https://api.deepinfra.com/v1/openai     meta-llama/Llama-3.3-70B-Instruct
#   Ollama      local, free http://localhost:11434/v1               llama3.3   (no key needed)
#   vLLM        self-hosted http://localhost:8000/v1                whatever you serve
#
# Groq is the default: the best free tier for open-weight models today.
# Get a key at https://console.groq.com/keys
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# THROUGHPUT WARNING (verified against Groq's free tier, Aug 2026):
#   llama-3.3-70b-versatile free tier = 12,000 tokens/minute
#   every request carries the whole ~5,300-token knowledge base
#   => roughly TWO questions per minute before Groq returns 429
# Fine for a demo, not for a live public widget. Options, cheapest first:
#   - llama-3.1-8b-instant   much higher TPM, lower answer quality
#   - a paid Groq tier
#   - Ollama locally (no limit at all)

# NOTE ON QUALITY: open-weight models follow instructions less reliably than
# the frontier models, so Layer 4 rejects more of their answers and visitors
# see the fallback more often. That is the guardrail working, not failing —
# but prefer the largest instruct-tuned model your budget allows.
